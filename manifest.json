{
  "manifest_version": 2,
  "name": "Reddit/Pixiv Download Button",
  "version": "1.0",
  "description": "Adds a download button to Reddit and Pixiv posts for personal use.",
  "icons": {
    "48": "icons/download.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "tabs",
    "https://api.redgifs.com/*",
    "https://media.redgifs.com/*",
    "https://imgur.com/*",
    "https://i.imgur.com/*",
    "https://www.pixiv.net/*",
    "https://i.pximg.net/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "vendor/ffmpeg/ffmpeg.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://www.reddit.com/*", "*://old.reddit.com/*", "*://www.pixiv.net/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    "vendor/ffmpeg/ffmpeg-core.js",
    "vendor/ffmpeg/ffmpeg-core.wasm"
  ]
}